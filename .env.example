# Firestore/Firebase Admin service account, JSON string (satu baris)
FIREBASE_SERVICE_ACCOUNT=

# Login admin dashboard (satu akun, dipakai oleh /api/admin/*)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Origin admin app terpisah yang diizinkan lewat CORS di src/proxy.ts (mis. https://admin.cemilantehrisma.com)
ADMIN_ORIGIN=

# Secret yang dipanggil admin app ke POST /api/revalidate setelah edit produk/kategori
REVALIDATE_SECRET=

# Secret untuk menandatangani cookie sesi customer (register/login di storefront)
SESSION_SECRET=

# Config Firebase Web App (client-safe, BUKAN service account) — dari Firebase Console
# > Project settings > General > Your apps > Web app. Dipakai khusus untuk tombol
# "Masuk dengan Google" di /login & /register (lihat src/lib/firebaseClient.ts).
# Provider Google juga harus diaktifkan di Firebase Console > Authentication > Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# CallMeBot WhatsApp API — untuk rekap harian /api/cron/daily-report
CALLMEBOT_API_KEY=
NOTIFY_PHONE=

# Bearer token untuk melindungi /api/cron/daily-report dari pemanggilan publik
CRON_SECRET=

# Cloudinary — upload bukti pembayaran checkout online (POST /api/upload-payment-proof).
# Pakai akun Cloudinary yang sama dengan cemilantehrisma-admin, copy 3 value ini dari
# .env.local repo admin supaya gambar bukti transfer bisa dilihat admin di akun yang sama.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
